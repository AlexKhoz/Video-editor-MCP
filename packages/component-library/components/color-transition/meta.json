{
  "id": "color-transition",
  "name": "Colour Transition",
  "description": "A full-frame colour overlay that fades in, tweens between two colours, then fades out.",
  "project": "src/projects/color-transition.ts",
  "durationParam": "durationInSeconds",
  "params": [
    { "key": "fromColor", "label": "From colour", "type": "color", "default": "#0ea5e9" },
    { "key": "toColor", "label": "To colour", "type": "color", "default": "#a855f7" },
    {
      "key": "durationInSeconds",
      "label": "Duration (s)",
      "type": "number",
      "default": 2,
      "min": 1,
      "max": 10,
      "step": 0.5
    }
  ]
}
