{
  "id": "animated-text",
  "name": "Animated Text",
  "description": "Text that slides and scales in, holds, then fades out.",
  "project": "src/projects/animated-text.ts",
  "durationParam": "durationInSeconds",
  "params": [
    { "key": "text", "label": "Text", "type": "text", "default": "Hello" },
    { "key": "color", "label": "Colour", "type": "color", "default": "#ffffff" },
    {
      "key": "durationInSeconds",
      "label": "Duration (s)",
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 10,
      "step": 0.5
    }
  ]
}
